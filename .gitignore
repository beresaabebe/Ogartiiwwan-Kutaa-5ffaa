# Built-in Git Ignore Template for Android

# Gradle files
.gradle/
build/
*/build/

# IntelliJ IDEA / Android Studio files
*.iml
.idea/
*.ipr
*.iws
.idea/workspace.xml
.idea/libraries/
.idea/caches/
.idea/modules.xml
.idea/navEditor.xml
.idea/assetWizardSettings.xml
.idea/modules/
.idea/runConfigurations/
.idea/scala_settings.xml
.idea/vcs.xml
.idea/copyright/
.idea/scopes/
.idea/findMessages.xml
.idea/sonarIssues.xml
.idea/shelf/

# Local configuration file (sdk path, etc)
local.properties

# Log files
*.log

# Android Studio Captures
captures/

# OS-specific files
.DS_Store
Thumbs.db

# JNI/Native build artifacts
.externalNativeBuild
.cxx/
*.so
*.o

# Sensitive Files (Firebase & Keys)
# It is recommended to keep these out of public repositories.
# If you are using a private repo, you might choose to track them.
# app/google-services.json
# *.jks
# *.p12
# *.keystore

# Backup and temp files
*.bak
*.swp
*~
